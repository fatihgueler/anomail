# Zwei getrennte Verbindungen, und das ist keine Bequemlichkeit.
#
# DATABASE_URL     - Eigentuemer. Fuer Migrationen, Seed und den Anmeldevorgang
#                    (dort gibt es noch keinen Nutzerkontext). Umgeht RLS.
# DATABASE_URL_APP - Rolle anomail_app. So und nur so laufen nutzerbezogene
#                    Abfragen. Unterliegt Row Level Security.
#
# Das Passwort der Anwendungsrolle wird beim Ausrollen gesetzt, nicht in einer
# Migration - sonst stuende es im Repository. Das erledigt
# scripts/deploy-bootstrap.mts aus APP_DB_PASSWORD.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/anomail
DATABASE_URL_APP=postgres://anomail_app:CHANGE_ME@localhost:5432/anomail

# Passwort der Rolle anomail_app. Muss mit dem Passwort in DATABASE_URL_APP
# uebereinstimmen. Nur beim Ausrollen gebraucht, nicht zur Laufzeit.
APP_DB_PASSWORD=CHANGE_ME

# Auth.js. Signiert Sitzungs-Cookies und dient als Schluessel fuer die
# Bezeichner-Hashes der Ratenbegrenzung. Erzeugen mit: npx auth secret
AUTH_SECRET=CHANGE_ME
AUTH_URL=http://localhost:3000

# Absenderadresse der Anmeldelinks.
AUTH_EMAIL_FROM=anmeldung@anomail.local

# Geheimnis fuer den Cron-Endpunkt /api/cron/release-leases, der abgelaufene
# Briefzuweisungen freigibt. Vercel sendet es automatisch als
# "Authorization: Bearer <CRON_SECRET>". Ohne gesetztes Geheimnis bleibt der
# Endpunkt geschlossen.
CRON_SECRET=CHANGE_ME

# Mailversand. "console" schreibt den Anmeldelink ins Terminal und ist
# ausschliesslich fuer die Entwicklung - im Betrieb wird das abgelehnt, weil
# der Link sonst im Serverprotokoll steht. Im Betrieb: "smtp".
MAIL_TRANSPORT=console

# Nur bei MAIL_TRANSPORT=smtp. Anbieterneutral - funktioniert mit Mailgun,
# Brevo, Postmark, Amazon SES oder einem eigenen Server.
#
# Ohne diese vier Werte kommt kein Anmeldelink an, und ohne Anmeldelink kommt
# niemand in die Anwendung. Sie sind bei einem Betriebs-Deploy also Pflicht.
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# Leer lassen: wird aus dem Port abgeleitet (465 = true, sonst false).
# Nur setzen, wenn der Anbieter davon abweicht.
# SMTP_SECURE=false

# Inhaltspruefung beim Schreiben. "rules" arbeitet ohne fremden Dienst und
# reicht fuer eine Vorfuehrung.
SAFETY_PROVIDER=rules
